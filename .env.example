# ===== POSTGRES =====
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=postgres

# ===== ODOO =====
ODOO_DB_NAME=your_odoo_database_name
ODOO_AUTOMATION_UID=your_automation_user_id
ODOO_API_KEY=your_odoo_api_key_here

# ===== N8N =====
N8N_ENCRYPTION_KEY=change_me_random_32_char_string
GENERIC_TIMEZONE=Asia/Dhaka
WEBHOOK_URL=https://your-current-tunnel-url.trycloudflare.com/

# ===== TELEGRAM BOT API =====
# Created via @BotFather on Telegram - see TELEGRAM_BOT_SETUP.md
# This token does not expire on its own (unlike WhatsApp's old 24-hour temporary token)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===== OLLAMA =====
OLLAMA_MODEL=gemma3:4b

# ===== NOTE: the following variables from an earlier draft are NOT currently used =====
# by docker-compose.yml or any n8n node in this workflow. Left here for reference only;
# safe to delete once confirmed unused in your final deployment.
# N8N_BASIC_AUTH_USER / N8N_BASIC_AUTH_PASSWORD: n8n's built-in account system is the
#   actual auth gate in current n8n versions - these legacy vars are not read (see
#   TROUBLESHOOTING.md #11).
# ODOO_URL / ODOO_DB / ODOO_USERNAME / ODOO_PASSWORD: superseded by ODOO_DB_NAME +
#   ODOO_AUTOMATION_UID + ODOO_API_KEY above, which match what the workflow's JSON-RPC
#   nodes actually use.